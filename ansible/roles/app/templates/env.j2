# File nay do Ansible sinh ra - dung sua tay tren VPS
DOMAIN={{ app_domain }}
GRAFANA_DOMAIN={{ grafana_domain }}
JENKINS_DOMAIN={{ jenkins_domain }}

BACKEND_IMAGE={{ backend_image }}
FRONTEND_IMAGE={{ frontend_image }}

JWT_SECRET={{ vault_jwt_secret }}
MONGO_ROOT_USER={{ mongo_root_user }}
MONGO_ROOT_PASSWORD={{ vault_mongo_root_password }}

MONGO_EXPORTER_URI=mongodb://{{ mongo_root_user }}:{{ vault_mongo_root_password }}@mongo:27017/admin

GRAFANA_ADMIN_USER={{ grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ vault_grafana_admin_password }}
GRAFANA_ROOT_URL=https://{{ grafana_domain }}

GMAIL_USERNAME={{ vault_gmail_username | default('') }}
GMAIL_PASSWORD={{ vault_gmail_password | default('') }}
