# ============================================================
#  BIEN MOI TRUONG CHO DOCKER COMPOSE (production)
#  Tren VPS file .env nay do Ansible sinh tu dong.
#  Copy thanh .env neu muon chay tay.
# ============================================================

# --- Domain ---
DOMAIN=todo.muatheme247.com
GRAFANA_DOMAIN=grafana.muatheme247.com
JENKINS_DOMAIN=jenkins.muatheme247.com

# --- Image tren GHCR ---
BACKEND_IMAGE=ghcr.io/dtien15/devop03-cuoikhoa-trandangtien-backend:latest
FRONTEND_IMAGE=ghcr.io/dtien15/devop03-cuoikhoa-trandangtien-frontend:latest

# --- Ung dung ---
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai

# --- MongoDB ---
MONGO_ROOT_USER=todoadmin
MONGO_ROOT_PASSWORD=doi-mat-khau-nay
MONGO_EXPORTER_URI=mongodb://todoadmin:doi-mat-khau-nay@mongo:27017/admin

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=doi-mat-khau-nay
GRAFANA_ROOT_URL=https://grafana.muatheme247.com

# --- Gmail cho chuc nang quen mat khau (de trong neu khong dung) ---
GMAIL_USERNAME=
GMAIL_PASSWORD=
